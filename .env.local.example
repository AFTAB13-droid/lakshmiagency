# MongoDB Atlas Free Cluster URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/lakshmi_agency?retryWrites=true&w=majority

# NextAuth Secret & URL
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# Cloudinary (Free Tier - for Product & Receipt uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Gmail SMTP for Forgot Password OTP (100% Free)
GMAIL_USER=your_company_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Google Webhook Security Token (Shared with Google Apps Script)
GOOGLE_WEBHOOK_SECRET=lakshmi_agency_secure_webhook_token_2026

# Agency Google Form Links
NEXT_PUBLIC_ORDER_FORM_URL=https://forms.gle/ydedLFJwcef59hPD7
NEXT_PUBLIC_REFUND_FORM_URL=https://forms.gle/ssWFUKVpoxoKzKWc8
